{
  "manifest_version": 3,
  "name": "Netflix Transcript Collector",
  "version": "3.5",
  "description": "Captures Netflix subtitle responses and converts TTML captions into an interactive timestamped transcript.",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Netflix Transcript Collector"
  }
}
